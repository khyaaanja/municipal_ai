# ─────────────────────────────────────────────────────────────
#  Bhaktapur Municipal AI — Copy to .env and fill every value
# ─────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=generate-with-python-secrets-token-hex-50
DEBUG=False
ALLOWED_HOSTS=bhaktapur.gov.np,www.bhaktapur.gov.np
SITE_URL=https://bhaktapur.gov.np

# City identity
CITY_NAME=Bhaktapur
CITY_COUNTRY=Nepal
CITY_LAT=27.6720
CITY_LNG=85.4298

# Database (Docker uses service name "db")
DB_NAME=municipal_ai_db
DB_USER=municipal
DB_PASSWORD=CHANGE_ME_strong_password
DB_ROOT_PASSWORD=CHANGE_ME_root_password
DB_HOST=db
DB_PORT=3306

# Redis (Docker uses service name "redis")
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AI — get key from console.groq.com (free)
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.65
AI_STREAM_ENABLED=true

# Payment — production keys from merchant.khalti.com
KHALTI_SECRET_KEY=live_secret_key_XXXX
KHALTI_PUBLIC_KEY=live_public_key_XXXX

# Email — Gmail App Password
# Create at: myaccount.google.com → Security → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx_xxxx_xxxx_xxxx
DEFAULT_FROM_EMAIL=Bhaktapur Municipality <noreply@bhaktapur.gov.np>

# 2FA encryption key
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# Error monitoring — free at sentry.io
SENTRY_DSN=https://XXXX@XXXX.ingest.sentry.io/XXXX

# OAuth (optional)
# GOOGLE_OAUTH2_KEY=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH2_SECRET=your-secret
# GITHUB_KEY=your-github-client-id
# GITHUB_SECRET=your-github-secret

# Deployment
BEHIND_PROXY=True
